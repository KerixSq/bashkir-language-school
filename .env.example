# URL и ключи находятся в Supabase > Project Settings > API Keys / Connect.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Допускается устаревшее имя: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_KEY=
TELEGRAM_BOT_TOKEN=
# Public configuration (never put the token in BOT_USERNAME):
BOT_USERNAME=
PUBLIC_WEB_URL=
# 'direct' or empty means direct. Compose defaults to socks5://tor:9050 when unset.
BOT_PROXY_URL=
