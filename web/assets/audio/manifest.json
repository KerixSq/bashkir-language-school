      "sha256": "6e41c7257d9fe8f46ec6ad17fbfa039b2388e2cfa967915c0d2c5bd353f6111c"
    },
    {
      "id": "05026b13b2d5e7de1f8d362c8a2e5c9d5361528a4f131068e651ee3e31ece296",
      "text": "эйе, минең ҡатыным мәктәптә эшләй",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:3c939245-7f41-5d74-b347-0f17d13cec15"
