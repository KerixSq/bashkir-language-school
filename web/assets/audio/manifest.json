      "text": "ҡулдарығыҙҙы күтәрегеҙ!",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:db78ed20-8ac0-5ca6-bf1a-46550ec0b799"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
