      "text": "тирәк",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:958d8ecc-854f-5481-993a-c9f976c2dff9"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
