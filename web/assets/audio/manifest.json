      "sha256": "57de424249e76d027b0748aeab284ae49d64a426c7741e3d4bccd8eff24f6096"
    },
    {
      "id": "0652e14a7a4e2f025a8adfe09b020169b2d7a76103210d8dccf18a4e990a3846",
      "text": "мин кем менән һөйләшәм?",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:c860177a-8308-56fd-9990-d9121753fd75"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
