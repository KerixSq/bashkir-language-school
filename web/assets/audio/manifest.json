      "id": "07a9ee61c1ebc8da5c01d743b277969b16ea5932a8727bc032a11ac17f874b23",
      "text": "өй туйығыҙ менән!",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-kk:2d7ca791-7b3e-5d95-bf76-935accc9ba67"
