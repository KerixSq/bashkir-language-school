      "sha256": "6c3a4e15f94e136fd6c893ac2ef93d9ffb6554fe890fbc6839ef0003ce12190d"
    },
    {
      "id": "0686265071bdc6478559955f6dc100464720de7b3a6bc93e13b5cda52965ae63",
      "text": "миңә балалар (ирҙәр, ҡатын- ҡыҙҙар) аяҡ кейеме күрһәтегеҙ әле?",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:8923c454-c339-5121-b8b5-f7ced2413c7d"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/0686265071bdc6478559955f6dc100464720de7b3a6bc93e13b5cda52965ae63.wav",
      "sha256": "51f91627bdf17b05ae86da5123a592246734a8b8555ec7804237a5324de133c5"
    },
    {
      "id": "06a4b5e74d2d893c834fe9c92aefde81757241059305453f35f23fe9545ef1ad",
      "text": "миңә яҙығыҙ әле, зинһар",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-kk:f6f057c2-3357-572e-9110-929b826e03a3"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/06a4b5e74d2d893c834fe9c92aefde81757241059305453f35f23fe9545ef1ad.wav",
      "sha256": "2df389cf2ca294be0b58acecaf94b63996da9d20b2480420f50b87aad0623276"
    },
    {
      "id": "06b4701e08393d48434be9ffb9ae2c31175e81ebcdbdcf8c980054e10379bd19",
      "text": "никах көнөгөҙ менән",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-kk:8c8028d1-ac65-5310-8cf7-e96f8adc41e3"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/06b4701e08393d48434be9ffb9ae2c31175e81ebcdbdcf8c980054e10379bd19.wav",
      "sha256": "3cc2af6828eb02ce462538b8425fbd9aa174740ab51455bcde2893dc4cd92c15"
    },
    {
      "id": "06c9e1ceeae014f3a6c6291abbfb968baa1a5b96e3be202a5c332d52b8eb83e6",
      "text": "был минең өсөн оло хөрмәт",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:18815031-50a0-5621-aca3-9a634de49b94"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/06c9e1ceeae014f3a6c6291abbfb968baa1a5b96e3be202a5c332d52b8eb83e6.wav",
      "sha256": "29e384d642c8cd1c930a5207d8f8d545872621b0540493ca9ae6776c0c45c557"
    },
    {
      "id": "06fcc3bdf4f4a3a0aebc6c411fa7e0924f1f6b20ce7d4e165d2206c217cb52cb",
      "text": "ял көндәрендә һеҙ нимә эшләйһегеҙ?",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-kk:a7e32f9c-2c6f-5715-927d-b3ce1ad747bb"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/06fcc3bdf4f4a3a0aebc6c411fa7e0924f1f6b20ce7d4e165d2206c217cb52cb.wav",
      "sha256": "77639e25c5dd7467d9a4b8eda79b663c4a4cbf616d397fb107772bc85875e846"
    },
    {
      "id": "07a66e5169fd1a8d5c7812d1648f72938abdfecee438085f1a1543afd387d53b",
      "text": "һеҙ ... һөйләшәһегеҙме? - башҡортса - якутса - инглизсә - төрөксә",
      "lang": "ba",
      "voice": "bak_aigul",
      "model": "v5_cis_base_nostress",
      "source_ids": [
        "ba-ru:4f146518-5921-5fa0-98de-ff1d2bdef1aa"
      ],
      "notice": "Синтезированная речь, требует оценки носителем",
      "path": "assets/audio/07a66e5169fd1a8d5c7812d1648f72938abdfecee438085f1a1543afd387d53b.wav",
      "sha256": "64ab909a0a6c576764c63c0fd0aff9171b8cca815342afed7dfeaf55fc116b1f"
    },
